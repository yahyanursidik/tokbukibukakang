---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
import { listPublicBooks, listPublicPoPeriods, listPublicReviews } from '@/lib/content/public';
import { formatRupiah, getSavingsPercent, hasDiscountPrice } from '@/lib/pricing';
import '@/styles/home.css';

export const prerender = false;

const books = await listPublicBooks();
const featuredBooks = books.filter((book) => book.featured).slice(0, 4);
const homeBooks = featuredBooks.length > 0 ? featuredBooks : books.slice(0, 4);
const reviews = await listPublicReviews(3);
const poPeriods = await listPublicPoPeriods();
const activePo = poPeriods
  .filter((period) => period.status === 'open')
  .sort((a, b) => a.endDate.getTime() - b.endDate.getTime())[0];
const activePoBooks = activePo ? books.filter((book) => activePo.bookSlugs.includes(book.slug)).slice(0, 5) : [];
const poHref = activePo ? `/po/${activePo.slug}` : '/po';

const formatDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

const formatAgeRange = (ageMin: number, ageMax: number) => {
  const youngest = Math.min(ageMin, ageMax);
  const oldest = Math.max(ageMin, ageMax);
  return youngest === oldest ? `${youngest} tahun` : `${youngest}-${oldest} tahun`;
};

const formatBookPrice = (price: number) => (price > 0 ? formatRupiah(price) : 'Lihat pilihan paket');

const selectionGuides = [
  {
    title: 'Cocok untuk usianya',
    description: 'Rentang usia terlihat sejak awal agar pilihan lebih sesuai dengan tahap tumbuh anak.'
  },
  {
    title: 'Tahu isi sebelum membeli',
    description: 'Baca ringkasan, catatan orang tua, dan Catatan dari Books by Ibunya Kakang.'
  },
  {
    title: 'Harga PO mudah dibandingkan',
    description: 'Harga asli, harga PO, dan nilai hemat ditampilkan tanpa perlu menghitung sendiri.'
  }
];

const orderSteps = [
  { title: 'Pilih', description: 'Temukan buku berdasarkan usia, kebutuhan, dan resensinya.' },
  { title: 'Pesan', description: 'Masukkan buku ke keranjang lalu lengkapi data penerima.' },
  { title: 'Bayar', description: 'Ikuti invoice dan salin nomor rekening yang tersedia.' },
  { title: 'Pantau', description: 'Konfirmasi pembayaran dan terima kabar pesanan via WhatsApp.' }
];
---

<BaseLayout
  title={siteConfig.name}
  description="Buku anak Islami terkurasi dengan panduan usia, resensi untuk orang tua, dan harga pre-order yang jelas."
>
  <section class="store-hero">
    <div class="page-shell store-hero__grid">
      <div class="store-hero__copy">
        <p class="store-kicker">Buku anak Islami pilihan keluarga</p>
        <h1>Buku yang baik, dipilih dengan lebih yakin.</h1>
        <p class="store-hero__lead">
          Temukan bacaan yang sesuai usia anak, pahami isinya lewat resensi, lalu pesan dengan alur PO yang jelas dan mudah diikuti.
        </p>
        <div class="store-actions">
          <a class="store-button store-button--primary" href={poHref}>Lihat buku PO</a>
          <a class="store-button store-button--quiet" href="/buku">Jelajahi semua buku</a>
        </div>
        <ul class="store-trust" aria-label="Keunggulan layanan">
          <li>Panduan usia</li>
          <li>Resensi untuk orang tua</li>
          <li>Info PO transparan</li>
        </ul>
      </div>
      <figure class="store-hero__visual">
        <img
          src="/images/hero-muslimah-reading.png"
          alt="Ibu muslimah membacakan buku bersama putra-putrinya"
          loading="eager"
          decoding="async"
        />
        <figcaption>Momen membaca yang tumbuh bersama anak.</figcaption>
      </figure>
    </div>
  </section>

  <section class="po-strip" aria-labelledby="active-po-title">
    <div class="page-shell">
      {
        activePo ? (
          <div class="po-strip__grid">
            <div class="po-strip__intro">
              <p class="store-kicker store-kicker--light">PO sedang dibuka</p>
              <h2 id="active-po-title">{activePo.title}</h2>
              <p>{activePo.description}</p>
              <dl class="po-dates">
                <div>
                  <dt>Tutup PO</dt>
                  <dd>{formatDate.format(activePo.endDate)}</dd>
                </div>
                <div>
                  <dt>Estimasi kirim</dt>
                  <dd>{formatDate.format(activePo.estimatedShippingDate)}</dd>
                </div>
              </dl>
              <a class="store-button store-button--light" href={poHref}>Lihat detail dan pesan</a>
            </div>
            {activePoBooks.length > 0 && (
              <div class="po-books" aria-label="Buku dalam periode PO">
                {activePoBooks.map((book) => (
                  <a class="po-book" href={`/buku/${book.slug}`}>
                    <span class="po-book__cover">
                      <img src={book.coverImage} alt={`Sampul ${book.title}`} loading="lazy" />
                    </span>
                    <span class="po-book__title">{book.title}</span>
                    <span class="po-book__price">{formatBookPrice(book.price)}</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        ) : (
          <div class="po-strip__empty">
            <div>
              <p class="store-kicker store-kicker--light">Periode pre-order</p>
              <h2 id="active-po-title">PO berikutnya sedang disiapkan.</h2>
              <p>Sambil menunggu, Ibu bisa melihat koleksi ready stock dan membaca resensi pilihan.</p>
            </div>
            <a class="store-button store-button--light" href="/buku">Lihat buku ready stock</a>
          </div>
        )
      }
    </div>
  </section>

  <section class="store-section" aria-labelledby="featured-title">
    <div class="page-shell">
      <header class="store-section__head">
        <div>
          <p class="store-kicker">Pilihan untuk dibaca bersama</p>
          <h2 id="featured-title">Mulai dari buku yang paling sesuai</h2>
        </div>
        <a class="store-text-link" href="/buku">Lihat semua buku <span aria-hidden="true">→</span></a>
      </header>
      {
        homeBooks.length > 0 ? (
          <div class="book-shelf">
            {homeBooks.map((book) => (
              <article class="book-tile">
                <a class="book-tile__cover" href={`/buku/${book.slug}`} aria-label={`Lihat ${book.title}`}>
                  <img src={book.coverImage} alt={`Sampul ${book.title}`} loading="lazy" />
                  <span class="book-tile__stock">{book.stockType === 'preorder' ? 'Pre-order' : 'Ready stock'}</span>
                </a>
                <div class="book-tile__body">
                  <p class="book-tile__meta">Usia {formatAgeRange(book.ageMin, book.ageMax)}</p>
                  <h3><a href={`/buku/${book.slug}`}>{book.title}</a></h3>
                  <p class="book-tile__description">{book.shortDescription}</p>
                  <div class="book-tile__footer">
                    <div class="book-price">
                      {hasDiscountPrice(book) && <del>{formatRupiah(book.originalPrice!)}</del>}
                      <strong>{formatBookPrice(book.price)}</strong>
                      {hasDiscountPrice(book) && <span>Hemat {getSavingsPercent(book)}%</span>}
                    </div>
                    <a class="book-tile__arrow" href={`/buku/${book.slug}`} aria-label={`Buka detail ${book.title}`}>→</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="store-empty">Koleksi buku sedang disiapkan.</div>
        )
      }
    </div>
  </section>

  <section class="selection-section" aria-labelledby="selection-title">
    <div class="page-shell selection-section__grid">
      <div class="selection-section__intro">
        <p class="store-kicker">Tidak perlu memilih sendirian</p>
        <h2 id="selection-title">Informasi yang ibu butuhkan, sebelum memutuskan.</h2>
        <p>Setiap halaman buku dirapikan supaya manfaat, isi, dan kecocokannya untuk keluarga mudah dipahami.</p>
        <a class="store-text-link" href="/panduan-belanja">Baca panduan belanja <span aria-hidden="true">→</span></a>
      </div>
      <ol class="selection-list">
        {selectionGuides.map((guide, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{guide.title}</h3>
              <p>{guide.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {reviews.length > 0 && (
    <section class="store-section review-section" aria-labelledby="reviews-title">
      <div class="page-shell review-section__grid">
        <header>
          <p class="store-kicker">Catatan sebelum membeli</p>
          <h2 id="reviews-title">Baca dulu, baru tentukan bukunya.</h2>
          <p>Resensi membantu ibu melihat tema, pendekatan isi, dan hal yang perlu diperhatikan saat mendampingi anak.</p>
          <a class="store-button store-button--quiet" href="/resensi">Buka semua resensi</a>
        </header>
        <div class="review-list">
          {reviews.map((review) => (
            <article>
              <p>{review.sourceType === 'original' ? 'Resensi Books by Ibunya Kakang' : 'Ringkasan bacaan'}</p>
              <h3>{review.title}</h3>
              <div>{review.summary}</div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="order-section" aria-labelledby="order-title">
    <div class="page-shell">
      <header class="store-section__head">
        <div>
          <p class="store-kicker">Cara memesan</p>
          <h2 id="order-title">Empat langkah, dari memilih sampai menerima kabar.</h2>
        </div>
        <a class="store-text-link" href="/panduan-belanja">Panduan lengkap <span aria-hidden="true">→</span></a>
      </header>
      <ol class="order-steps">
        {orderSteps.map((step, index) => (
          <li>
            <span class="order-steps__number">{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="help-section">
    <div class="page-shell help-section__inner">
      <div>
        <p class="store-kicker store-kicker--light">Masih bingung memilih?</p>
        <h2>Ceritakan usia dan kebutuhan anak, kami bantu carikan.</h2>
        <p>Ibu bisa bertanya tentang isi buku, stok, usia pembaca, atau proses pre-order langsung melalui WhatsApp.</p>
      </div>
      <a
        class="store-button store-button--light"
        href={`${siteConfig.whatsappUrl}?text=${encodeURIComponent("Assalamu'alaikum, saya ingin dibantu memilih buku yang sesuai untuk anak.")}`}
      >
        Tanya Ibu Kakang
      </a>
    </div>
  </section>
</BaseLayout>
